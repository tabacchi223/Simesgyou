 document.getElementById("prepTomorrow").innerHTML=r.prepForNext.length?r.prepForNext.map(function(p){return '<li class="row"><label class="ck"><span>'+esc(p.name)+(p.quantity?" "+esc(p.quantity):"")+(p.assignee?"（"+esc(p.assignee)+"）":"")+(p.memo?"<small>"+esc(p.memo)+"</small>":"")+'</span></label><button class="del" data-pdel="'+p.id+'" aria-label="削除">×</button></li>'}).join(""):'<li><label class="ck"><span>まだ登録がありません</span></label></li>';
 var cands=store.prepCandidates.slice().sort(function(a,b){return (b.useCount||0)-(a.useCount||0)});
 document.getElementById("prepCands").innerHTML=cands.map(function(c){return '<button class="chip" data-cand="'+esc(c.name)+'">'+esc(c.name)+"</button>"}).join("");
 document.getElementById("candList").innerHTML=cands.map(function(c){return "<li class='row'><label class='ck'><span>"+esc(c.name)+"<small>数量："+esc(c.quantity||"－")+"／担当："+esc(c.assignee||"－")+"／メモ："+esc(c.memo||"－")+"</small></span></label><button class='del' data-cdel='"+esc(c.name)+"' aria-label='候補を削除'>×</button></li>"}).join("")}
function addPrep(name,qty,asg,memo){name=(name||"").trim();if(!name)return;var r=rec();r.prepForNext.push({id:uid(),name:name,quantity:qty||"",assignee:asg||"",memo:memo||""});
 var c=store.prepCandidates.find(function(x){return x.name===name});if(c){c.quantity=qty||c.quantity;c.assignee=asg||c.assignee;c.memo=memo||c.memo;c.useCount=(c.useCount||0)+1}else store.prepCandidates.push({name:name,quantity:qty||"",assignee:asg||"",memo:memo||"",useCount:1});
 save();renderPrepTomorrow();renderReport()}
function renderTodoTomorrow(){var r=rec();
 document.getElementById("todoTomorrow").innerHTML=r.todoForNext.length?r.todoForNext.map(function(p){return '<li class="row"><label class="ck"><span>'+esc(p.text)+(p.assignee?"（"+esc(p.assignee)+"）":"")+'</span></label><button class="del" data-tdel="'+p.id+'" aria-label="削除">×</button></li>'}).join(""):'<li><label class="ck"><span>まだ登録がありません</span></label></li>'}
function renderMembers(){document.getElementById("membersToday").innerHTML=membersHtml(store.shifts[TODAY]);
 document.getElementById("membersTomorrow").innerHTML=membersHtml(store.shifts[TOMORROW]);
 renderShiftEditor()}
function renderReport(){var r=rec();var dow=dowOf(TODAY);var req=requiredItems(dow);var n=0;req.forEach(function(t){if(r.checks[t])n++});
 var lines=[];lines.push("【締めチェック完了報告】");lines.push(jpDate(TODAY)+"　担当："+(r.assignee||"未選択"));
 lines.push("チェック："+n+" / "+req.length+(n===req.length&&r.completedAt?"　完了 "+r.completedAt:""));
 var ords=ORDERS[dow]||[];if(ords.length)lines.push("本日の発注："+ords.map(function(o){return o+" "+(r.checks["最終発注："+o]?"済":"未")}).join("／"));else lines.push("本日の発注：なし");
 lines.push("申し送り："+(r.note||"なし"));
 lines.push("");lines.push("明日の仕込み：");
 if(r.prepForNext.length)r.prepForNext.forEach(function(p){lines.push("・"+p.name+(p.quantity?" "+p.quantity:"")+(p.assignee?"（"+p.assignee+"）":"")+(p.memo?" "+p.memo:""))});else lines.push("・なし");
 lines.push("");lines.push("明日のTodo：");
 if(r.todoForNext.length)r.todoForNext.forEach(function(p){lines.push("・"+p.text+(p.assignee?"（"+p.assignee+"）":""))});else lines.push("・なし");
 lines.push("");lines.push("明日のメンバー（"+jpDate(TOMORROW)+"）：");
 var tm=store.shifts[TOMORROW];if(tm&&tm.length){var g=groupMembers(tm);["社員","ランチ","ディナー"].forEach(function(k){lines.push("【"+k+"】");if(g[k].length)g[k].forEach(function(x){lines.push("・"+x)});else lines.push("・なし")})}else lines.push("・なし");
 var tords=ORDERS[dowOf(TOMORROW)]||[];lines.push("");lines.push("明日の発注先："+(tords.length?tords.join("、"):"なし"));
 document.getElementById("report").textContent=lines.join("\n")}
function renderShiftEditor(){var d=document.getElementById("shiftDate");if(!d.value)d.value=TOMORROW;
 document.getElementById("memberChips").innerHTML=store.knownMembers.map(function(m){return '<button class="chip" data-mem="'+esc(m)+'">'+esc(m)+"</button>"}).join("");
 var list=store.shifts[d.value]||[];
 document.getElementById("shiftDayList").innerHTML=list.map(function(m,i){return '<li class="row"><label class="ck"><span>'+esc(m.name)+"<small>"+esc(m.detail)+'</small></span></label><button class="del" data-sdel="'+i+'" aria-label="削除">×</button></li>'}).join("")}
function parseCsv(text){var rows=[],row=[],cur="",q=false;for(var i=0;i<text.length;i++){var c=text[i];if(q){if(c==='"'){if(text[i+1]==='"'){cur+='"';i++}else q=false}else cur+=c}else if(c==='"')q=true;else if(c===","){row.push(cur);cur=""}else if(c==="\n"){row.push(cur);rows.push(row);row=[];cur=""}else if(c!=="\r")cur+=c}if(cur||row.length){row.push(cur);rows.push(row)}return rows}
function importCsv(text){var rows=parseCsv(text);if(rows.length<2)return 0;var dates=rows[0].slice(2).map(function(d){return d.trim().replace(/\//g,"-")});var added=0;
 for(var r=1;r<rows.length;r++){var name=(rows[r][0]||"").trim();if(!name)continue;if(store.knownMembers.indexOf(name)<0)store.knownMembers.push(name);
  for(var c=2;c<rows[r].length;c++){var v=(rows[r][c]||"").trim();var date=dates[c-2];if(!date)continue;if(!v||v==="×"||v==="TUTU")continue;
   var detail="○";var m=v.match(/(\d{1,2}:\d{2})\s*[~〜]\s*(\d{1,2}:\d{2})?/);if(m)detail=(m[1]+" ~ "+(m[2]||"")).trim();
   if(!store.shifts[date])store.shifts[date]=[];var ex=store.shifts[date].find(function(x){return x.name===name});if(ex)ex.detail=detail;else{store.shifts[date].push({name:name,detail:detail});added++}}}
 save();renderMembers();return added}
var undoTimer=null,undoSnap=null;
function renderAll(){renderList();renderAssignee();renderPrevNote();renderPrepTodoToday();renderPrepTomorrow();renderTodoTomorrow();renderMembers();document.getElementById("note").value=rec().note||"";renderReport()}
document.addEventListener("change",function(e){var r=rec();
 if(e.target.dataset&&e.target.dataset.k&&!isPreview()){r.checks[e.target.dataset.k]=e.target.checked;save();count()}
 if(e.target.dataset&&e.target.dataset.pd){r.prepDone[e.target.dataset.pd]=e.target.checked;save()}
 if(e.target.dataset&&e.target.dataset.td){r.todoDone[e.target.dataset.td]=e.target.checked;save()}});
document.addEventListener("click",function(e){var t=e.target;var r=rec();
 if(t.dataset&&t.dataset.d){viewDow=+t.dataset.d;renderList()}
 if(t.id==="backToday"){viewDow=dowOf(TODAY);renderList()}
 if(t.dataset&&t.dataset.asg){r.assignee=r.assignee===t.dataset.asg?"":t.dataset.asg;save();renderAssignee();count()}
 if(t.dataset&&t.dataset.cand){var c=store.prepCandidates.find(function(x){return x.name===t.dataset.cand});if(c)addPrep(c.name,c.quantity,c.assignee,c.memo)}
 if(t.dataset&&t.dataset.pdel){r.prepForNext=r.prepForNext.filter(function(p){return p.id!==t.dataset.pdel});save();renderPrepTomorrow();renderReport()}
 if(t.dataset&&t.dataset.cdel){store.prepCandidates=store.prepCandidates.filter(function(x){return x.name!==t.dataset.cdel});save();renderPrepTomorrow()}
 if(t.dataset&&t.dataset.tdel){r.todoForNext=r.todoForNext.filter(function(p){return p.id!==t.dataset.tdel});save();renderTodoTomorrow();renderReport()}
 if(t.dataset&&t.dataset.mem){var d=document.getElementById("shiftDate").value||TOMORROW;var det=document.getElementById("shiftDetail").value.trim()||"○";if(!store.shifts[d])store.shifts[d]=[];if(!store.shifts[d].find(function(x){return x.name===t.dataset.mem}))store.shifts[d].push({name:t.dataset.mem,detail:det});save();renderMembers()}
 if(t.dataset&&t.dataset.sdel!==undefined&&t.dataset.sdel!==""){var d2=document.getElementById("shiftDate").value;(store.shifts[d2]||[]).splice(+t.dataset.sdel,1);save();renderMembers()}});
document.getElementById("note").addEventListener("input",function(e){rec().note=e.target.value;save();renderReport()});
document.getElementById("prepAdd").addEventListener("click",function(){addPrep(document.getElementById("prepName").value,document.getElementById("prepQty").value,document.getElementById("prepAsg").value,document.getElementById("prepMemo").value);document.getElementById("prepName").value="";document.getElementById("prepQty").value="";document.getElementById("prepMemo").value=""});
document.getElementById("prepCopy").addEventListener("click",function(){var y=dayRec(YESTERDAY);y.prepForNext.forEach(function(p){if(!rec().prepForNext.find(function(x){return x.name===p.name}))rec().prepForNext.push({id:uid(),name:p.name,quantity:p.quantity,assignee:p.assignee,memo:p.memo})});save();renderPrepTomorrow();renderReport()});
document.getElementById("todoAdd").addEventListener("click",function(){var v=document.getElementById("todoText").value.trim();if(!v)return;rec().todoForNext.push({id:uid(),text:v,assignee:document.getElementById("todoAsg").value});document.getElementById("todoText").value="";save();renderTodoTomorrow();renderReport()});
document.getElementById("sendIncomplete").addEventListener("click",function(){var r=rec();requiredItems(dowOf(TODAY)).forEach(function(t){if(!r.checks[t]&&!r.todoForNext.find(function(x){return x.text===t}))r.todoForNext.push({id:uid(),text:t,assignee:""})});save();renderTodoTomorrow();renderReport()});
document.getElementById("shiftDate").addEventListener("change",renderShiftEditor);
document.getElementById("shiftFile").addEventListener("change",function(e){var f=e.target.files[0];if(!f)return;var rd=new FileReader();rd.onload=function(){var n=importCsv(String(rd.result));alert("シフトを取り込みました（"+n+"件追加）")};rd.readAsText(f)});
document.getElementById("shiftImport").addEventListener("click",function(){var v=document.getElementById("shiftPaste").value;if(!v.trim())return;var n=importCsv(v);alert("シフトを取り込みました（"+n+"件追加）")});
document.getElementById("copyReport").addEventListener("click",function(){var txt=document.getElementById("report").textContent;function done(){var b=document.getElementById("copyReport");b.textContent="コピーしました";setTimeout(function(){b.textContent="報告文をコピー"},1500)}
 if(navigator.clipboard&&navigator.clipboard.writeText)navigator.clipboard.writeText(txt).then(done,function(){fallback()});else fallback();
 function fallback(){var ta=document.createElement("textarea");ta.value=txt;document.body.appendChild(ta);ta.select();try{document.execCommand("copy");done()}catch(e){}document.body.removeChild(ta)}});
document.getElementById("reset").addEventListener("click",function(){var r=rec();var n=Object.keys(r.checks).filter(function(k){return r.checks[k]}).length;
 if(!confirm("チェックを全部外します（現在 "+n+" 件）。よろしいですか？"))return;
 undoSnap=JSON.stringify(r.checks);r.checks={};r.completedAt="";save();renderList();
 var bar=document.getElementById("undoBar");bar.style.display="block";clearTimeout(undoTimer);undoTimer=setTimeout(function(){bar.style.display="none";undoSnap=null},20000)});
document.getElementById("undoBtn").addEventListener("click",function(){if(undoSnap){rec().checks=JSON.parse(undoSnap);save();renderList()}document.getElementById("undoBar").style.display="none";undoSnap=null});
document.getElementById("exportBtn").addEventListener("click",function(){var blob=new Blob([JSON.stringify(store,null,1)],{type:"application/json"});var a=document.createElement("a");a.href=URL.createObjectURL(blob);a.download="shimecheck-backup-"+TODAY+".json";a.click();setTimeout(function(){URL.revokeObjectURL(a.href)},2000)});
document.getElementById("importBtn").addEventListener("click",function(){document.getElementById("importFile").click()});
document.getElementById("importFile").addEventListener("change",function(e){var f=e.target.files[0];if(!f)return;var rd=new FileReader();rd.onload=function(){try{var s=JSON.parse(String(rd.result));if(!s.days)throw new Error("bad");if(!confirm("現在のデータをバックアップの内容で置き換えます。よろしいですか？"))return;store=s;save();renderAll();alert("読み込みました")}catch(err){alert("読み込めませんでした")}};rd.readAsText(f)});
load();renderAll();
if("serviceWorker" in navigator){try{navigator.serviceWorker.register("sw.js").catch(function(){})}catch(e){}}
