<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>締めチェック</title>
<style>
:root{--bg:#f3f5f7;--card:#fff;--ink:#1b2430;--sub:#6a7685;--line:#dde2e8;--ac:#1f5fbf;--ok:#2e8b57;--okbg:#e6f4ec;--warn:#b4570a;--warnbg:#fdf0e2;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#10151c;--card:#1a212b;--ink:#e8edf3;--sub:#93a0b0;--line:#2b3542;--ac:#6ea3ee;--ok:#5cc58a;--okbg:#17302443;--warn:#f0a35e;--warnbg:#3a2a1a}}
:root[data-theme="dark"]{--bg:#10151c;--card:#1a212b;--ink:#e8edf3;--sub:#93a0b0;--line:#2b3542;--ac:#6ea3ee;--ok:#5cc58a;--okbg:#17302443;--warn:#f0a35e;--warnbg:#3a2a1a}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 "Hiragino Sans","Noto Sans JP",system-ui,sans-serif}
main{max-width:560px;margin:0 auto;padding:16px 14px 96px}
h1{font-size:22px;margin:4px 0 2px}
.date{color:var(--sub);font-size:14px}
.days{display:flex;gap:6px;margin:12px 0;overflow-x:auto}
.days button{flex:1;min-width:40px;padding:8px 0;border:1px solid var(--line);background:var(--card);color:var(--ink);border-radius:8px;font:inherit;font-size:14px}
.days button[aria-pressed=true]{background:var(--ac);border-color:var(--ac);color:#fff}
.prog{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:12px 14px;margin-bottom:14px}
.bar{height:8px;background:var(--line);border-radius:4px;margin-top:8px;overflow:hidden}
.bar i{display:block;height:100%;width:0;background:var(--ok);transition:width .25s}
section{margin-bottom:16px}
h2{font-size:15px;margin:0 0 6px;padding-left:4px;display:flex;justify-content:space-between;color:var(--sub);font-weight:600}
ul{list-style:none;margin:0;padding:0;background:var(--card);border:1px solid var(--line);border-radius:12px;overflow:hidden}
li+li{border-top:1px solid var(--line)}
label{display:flex;gap:12px;align-items:center;padding:13px 14px;min-height:52px;cursor:pointer}
input{appearance:none;flex:none;width:26px;height:26px;border:2px solid var(--sub);border-radius:7px;margin:0;display:grid;place-content:center}
input:checked{background:var(--ok);border-color:var(--ok)}
input:checked::after{content:"";width:6px;height:12px;border:solid #fff;border-width:0 3px 3px 0;transform:rotate(45deg) translate(-1px,-1px)}
input:focus-visible{outline:3px solid var(--ac);outline-offset:2px}
input:checked+span{color:var(--sub);text-decoration:line-through}
small{display:block;color:var(--sub);font-size:12px}
.tag{margin-left:auto;font-size:12px;color:var(--warn);background:var(--warnbg);padding:2px 8px;border-radius:10px;white-space:nowrap}
.special ul{border-color:var(--warn)}
.done{display:none;text-align:center;background:var(--okbg);color:var(--ok);border-radius:12px;padding:14px;font-weight:700;margin-bottom:14px}
.foot{position:fixed;left:0;right:0;bottom:0;background:var(--bg);border-top:1px solid var(--line);padding:10px 14px calc(10px + env(safe-area-inset-bottom,0px))}
.foot button{display:block;width:100%;max-width:560px;margin:0 auto;padding:12px;border:1px solid var(--line);background:var(--card);color:var(--ink);border-radius:10px;font:inherit}
</style>
</head>
<body>
<main>
<h1>締めチェック</h1>
<div class="date" id="date"></div>
<div class="days" id="days" role="group" aria-label="曜日"></div>
<div class="prog"><b id="cnt">0 / 0</b> 完了<div class="bar"><i id="bar"></i></div></div>
<div class="done" id="done">すべて完了。おつかれさま！</div>
<div id="list"></div>
</main>
<div class="foot"><button id="reset">チェックを全部外す</button></div>
<script>
var W=["日","月","火","水","木","金","土"];
var G=[
["機器・火元",["洗浄機","フライヤー","フライヤー元栓","コーヒーマシン、グラインダー","スライサー","コンベクション掃除","電気、給湯器、ダクトを消す","ダクト洗う"]],
["掃除・洗い物",["トースター下のトレイ","キッチン内掃除機","手拭き、トーション洗い→干す","ダスター洗い（ブリーチ）"]],
["補充・仕込み",["オイル補充","洗剤補充","ジュース、ビール系補充","ハム系ラップ＆ミートペーパー","食材しまう","仕込み表","発注"]],
["戸締り",["充電（ライト、携帯、iPad）","テラスのもの全部なかに入れる","戸締り"]]
];
var sel=new Date().getDay(),state={};
function special(d){
 var s=[];
 if(d>=1&&d<=3)s.push(["22:00 ロープをしめる","月〜水"]);
 if(d>=1&&d<=6)s.push(["隣のトイレスペース 電気を消して施錠","月〜土"]);
 s.push(["前の食材ショーケースの電源オフ","2〜3日に一回"]);
 return s;
}
function key(d,t){return d+":"+t}
function load(){try{state=JSON.parse(localStorage.getItem("closing")||"{}")}catch(e){state={}}
 var t=new Date().toDateString();
 if(state._d!==t){state={_d:t};save();}}
function save(){try{localStorage.setItem("closing",JSON.stringify(state))}catch(e){}}
function item(d,t,tag){
 return '<li><label><input type="checkbox" data-k="'+key(d,t)+'"'+(state[key(d,t)]?' checked':'')+'><span>'+t+'</span>'+(tag?'<span class="tag">'+tag+'</span>':'')+'</label></li>';
}
function render(){
 var h="";
 G.forEach(function(g){h+='<section><h2>'+g[0]+'</h2><ul>'+g[1].map(function(t){return item(sel,t)}).join("")+'</ul></section>';});
 h+='<section class="special"><h2>今日だけの項目</h2><ul>'+special(sel).map(function(s){return item(sel,s[0],s[1])}).join("")+'</ul></section>';
 document.getElementById("list").innerHTML=h;
 var b=document.getElementById("days");
 b.innerHTML=W.map(function(w,i){return '<button aria-pressed="'+(i===sel)+'" data-d="'+i+'">'+w+'</button>'}).join("");
 document.getElementById("date").textContent=(sel===new Date().getDay()?"今日 ":"")+W[sel]+"曜日の締め";
 count();
}
function count(){
 var all=document.querySelectorAll("#list input"),n=0;
 all.forEach(function(i){if(i.checked)n++});
 document.getElementById("cnt").textContent=n+" / "+all.length;
 document.getElementById("bar").style.width=(all.length?n/all.length*100:0)+"%";
 document.getElementById("done").style.display=(n===all.length&&n>0)?"block":"none";
}
document.addEventListener("change",function(e){
 if(e.target.dataset.k){state[e.target.dataset.k]=e.target.checked;save();count();}
});
document.getElementById("days").addEventListener("click",function(e){
 if(e.target.dataset.d){sel=+e.target.dataset.d;render();}
});
document.getElementById("reset").addEventListener("click",function(){
 Object.keys(state).forEach(function(k){if(k.indexOf(sel+":")===0)delete state[k]});save();render();
});
load();render();
</script>
</body>
</html>
